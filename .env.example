# Configuración de integración con LandingJ4F
# URL base del servicio Go landing-server (producción por defecto o túnel/local)
LANDING_API_BASE_URL=https://landing-api.jffsolutions.com

# Clave API pública del proyecto Moody generada en LandingJ4F (formato j4fk_...)
# Dejar vacía para usar endpoints públicos /p/:slug
LANDING_API_KEY=

# Slug único del proyecto registrado en LandingJ4F
LANDING_PROJECT_SLUG=moody
