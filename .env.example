# Configuración de integración con LandingJ4F
# URL base del servicio Go landing-server
LANDING_API_BASE_URL=http://localhost:8092

# Clave API pública del proyecto Moody generada en LandingJ4F (formato j4fk_...)
# Dejar vacía para usar fallback local simulado o modo legacy /p/:slug
LANDING_API_KEY=

# Slug único del proyecto registrado en LandingJ4F
LANDING_PROJECT_SLUG=moody
